bridge.Text.text                    max_size:1024
bridge.KeyCombo.keys                max_size:6
bridge.KeyboardReport.keys          max_size:6
bridge.Strokes.strokes              max_size:1020
bridge.OtaBegin.sha256              max_size:32
bridge.OtaData.data                 max_size:1000
bridge.Hello.firmware_version       max_size:32
bridge.Hello.capabilities           max_count:12 max_size:16
bridge.Config.layout                max_size:16
bridge.Config.available_layouts     max_count:8 max_size:16
bridge.Status.layout                max_size:16
bridge.DeviceInfo.name              max_size:32
bridge.DeviceInfo.model             max_size:32
bridge.DeviceInfo.chip              max_size:32
bridge.DeviceInfo.reset_reason      max_size:16
bridge.DeviceInfo.apps              max_count:8
bridge.App.id                       max_size:16
bridge.App.name                     max_size:16
bridge.SecurityKey.status           max_size:32
bridge.Security.flash_encryption    max_size:12
bridge.Security.key_storage         max_size:12
bridge.Security.signer              max_size:32
bridge.Security.download_mode       max_size:12
bridge.Logs.data                    max_size:900
bridge.ProfileSecret.secret         max_size:32
bridge.Profiles.phone_locked_id     max_size:16
bridge.Request.msg                  anonymous_oneof:true
bridge.Event.msg                    anonymous_oneof:true
